// Configuración de Prisma para PostgreSQL (Neon)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ════════════════════════════════════════════════════════
// UNIVERSIDADES
// ════════════════════════════════════════════════════════

model University {
  id        String    @id @default(uuid())
  name      String    @unique  // "Facultad de Ingeniería - Udelar"
  code      String    @unique  // "fing"
  logo      String?            // URL o nombre de icono
  createdAt DateTime  @default(now())

  subjects  Subject[]
}

// ════════════════════════════════════════════════════════
// MATERIAS
// ════════════════════════════════════════════════════════

model Subject {
  id              String   @id @default(uuid())
  name            String   @unique
  code            String?  @unique
  description     String?
  icon            String?
  universityId    String
  university      University @relation(fields: [universityId], references: [id])
  price           Float?   @default(0) // Costo de acceso al curso
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  topics          Topic[]
}

// ════════════════════════════════════════════════════════
// TEMAS (Nodos del Roadmap)
// ════════════════════════════════════════════════════════

model Topic {
  id          String   @id @default(uuid())
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id])
  name        String              // "Límites", "Derivadas"
  description String?
  icon        String?             // Nombre del icono Lucide
  order       Int      @default(0) // Orden en el roadmap (camino recomendado)
  posX        Float    @default(0) // Posición X en el mapa visual
  posY        Float    @default(0) // Posición Y en el mapa visual
  createdAt   DateTime @default(now())

  exerciseNodes  ExerciseNode[]
  theory         TopicTheory?
}

// ════════════════════════════════════════════════════════
// TEÓRICO NECESARIO (por tema)
// ════════════════════════════════════════════════════════

model TopicTheory {
  id        String  @id @default(uuid())
  topicId   String  @unique
  topic     Topic   @relation(fields: [topicId], references: [id])
  content   String  @default("")  // Markdown con teórico necesario
  tips      String  @default("")  // Markdown con tips
}

// ════════════════════════════════════════════════════════
// NODOS DE EJERCICIOS (dentro de un tema)
// ════════════════════════════════════════════════════════

model ExerciseNode {
  id          String   @id @default(uuid())
  topicId     String
  topic       Topic    @relation(fields: [topicId], references: [id])
  name        String              // "Nivel 1 - Básico"
  level       Int      @default(1) // 1=básico, 2=intermedio, 3=avanzado
  order       Int      @default(0)
  posX        Float    @default(0)
  posY        Float    @default(0)
  createdAt   DateTime @default(now())

  exercises   ExerciseItem[]
}

// ════════════════════════════════════════════════════════
// EJERCICIOS INDIVIDUALES
// ════════════════════════════════════════════════════════

model ExerciseItem {
  id            String    @id @default(uuid())
  nodeId        String
  node          ExerciseNode @relation(fields: [nodeId], references: [id])
  title         String             // "Ejercicio 1: Límite por sustitución"
  statement     String             // Planteamiento del ejercicio
  introduction  String  @default("") // Breve intro/lectura previa
  hints         String  @default("[]") // JSON array de sugerencias de prompts
  order         Int     @default(0)
  points        Int     @default(10) // Puntos al completar
  createdAt     DateTime @default(now())

  completions   UserExerciseCompletion[]
  chatMessages  ChatMessage[]
}

// ════════════════════════════════════════════════════════
// USUARIOS
// ════════════════════════════════════════════════════════

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  password         String
  name             String?
  role             String    @default("USER") // USER o ADMIN
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastInteraction  DateTime?

  subscription     Subscription?
  messages         ChatMessage[]
  studySessions    StudySession[]
  completions      UserExerciseCompletion[]
}

// ════════════════════════════════════════════════════════
// COMPLETACIÓN DE EJERCICIOS (tracking de progreso)
// ════════════════════════════════════════════════════════

model UserExerciseCompletion {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  exerciseId  String
  exercise    ExerciseItem @relation(fields: [exerciseId], references: [id])
  points      Int      @default(0)
  completedAt DateTime @default(now())

  @@unique([userId, exerciseId])
}

// ════════════════════════════════════════════════════════
// SUSCRIPCIONES
// ════════════════════════════════════════════════════════

model Subscription {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])
  status        String   @default("trial") // trial, active, canceled, expired
  stripeId      String?
  expiresAt     DateTime
}

// ════════════════════════════════════════════════════════
// SESIONES DE ESTUDIO (Cronómetro)
// ════════════════════════════════════════════════════════

model StudySession {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  date      DateTime @db.Date
  duration  Int      @default(0) // En segundos
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

// ════════════════════════════════════════════════════════
// HISTORIAL DE CHAT (vinculado a ejercicios)
// ════════════════════════════════════════════════════════

model ChatMessage {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  role        String   // user o assistant
  content     String
  exerciseId  String?
  exercise    ExerciseItem? @relation(fields: [exerciseId], references: [id])
  createdAt   DateTime @default(now())
}
